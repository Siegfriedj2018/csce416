{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "c/c++: g++ build and debug file",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceRoot}/TwoWayAsyncMesg/TwoWayAsyncMesg/",
      "args": [
        "50000"
      ],
      "stopAtEntry": false,
      "cwd": "${fileDirname}",
      "environment": [],
      "externalConsole": false,
      "MIMode": "gdb",
      "setupCommands": [
          {
              "description": "Enable pretty-printing for gdb",
              "text": "-enable-pretty-printing",
              "ignoreFailures": true
          },
          {
              "description": "Set Disassembly Flavor to Intel",
              "text": "-gdb-set disassembly-flavor intel",
              "ignoreFailures": true
          }
      ]
    }

  ]
}